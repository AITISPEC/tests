        "\\phi_1^'+i\\phi_2^'=e^{-i\\alpha}(\\phi_1+i\\phi_2),\\,\\phi_1^'-i\\phi_2^'=e^{i\\alpha}(\\phi_1-i\\phi_2)\\,.",
        "\\phi(x)\\rightarrow e^{-i\\alpha(x)}\\phi(x),\\,\\phi^*(x)\\rightarrow e^{i\\alpha(x)}\\phi^*(x)",
        "A_{\\mu}",
        "\\mathcal{L_1}=-ie(\\phi^*\\partial^{\\mu}\\phi-\\phi\\partial^{\\mu}\\phi^*)A_{\\mu}\\,,",
        "\\mathcal{L_2}=e^2A_{\\mu}A^{\\mu}\\phi^*\\phi\\,,",
        "\\mathcal{L}+\\mathcal{L_1}+\\mathcal{L_2}\\,",
        "F_{\\mu\\nu}=\\partial_{\\mu}A_{\\nu}-\\partial_{\\nu}A_{\\mu}",
        "\\mathcal{L}_{tot}=(\\partial_{\\mu}\\phi)(\\partial^{\\mu}\\phi^*)-m^2\\phi^*\\phi-ie(\\phi^*\\partial^{\\mu}\\phi-\\phi\\partial^{\\mu}\\phi^*)A_{\\mu}+e^2A_{\\mu}A^{\\mu}\\phi^*\\phi-\\frac{1}{16\\pi}F_{\\mu\\nu}F^{\\mu\\nu}\\,,",
        "\\phi^*"
      ]
    }
  ]
